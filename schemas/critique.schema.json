{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/critique.schema.json",
  "title": "Narrative Writing Critique v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "fidelity",
    "quality",
    "anti_patterns",
    "issues",
    "preserve",
    "patch_targets",
    "revision_strategy"
  ],
  "properties": {
    "decision": {
      "enum": [
        "PASS",
        "PATCH_REQUIRED"
      ]
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "violations"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "violations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/violation"
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meaning_density",
        "progression",
        "immersion",
        "specificity",
        "restraint",
        "coherence"
      ],
      "properties": {
        "meaning_density": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "progression": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "immersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "specificity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "restraint": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "coherence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "anti_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "count",
          "locations"
        ],
        "properties": {
          "type": {
            "enum": [
              "fake_depth",
              "abstract_padding",
              "generic_philosophy",
              "over_explanation",
              "repetitive_contrast",
              "emotional_overstatement",
              "early_reveal",
              "rhythm_monotony"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "preserve": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "patch_targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "revision_strategy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "severity": {
      "enum": [
        "minor",
        "moderate",
        "major",
        "fatal"
      ]
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "type",
        "description",
        "severity"
      ],
      "properties": {
        "location": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "$ref": "#/$defs/severity"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "severity",
        "diagnosis",
        "effect",
        "action"
      ],
      "properties": {
        "location": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "diagnosis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "description"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "effect": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
