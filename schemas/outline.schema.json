{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative-harness.local/schemas/outline.schema.json",
  "title": "Conventional Writing Outline",
  "description": "A1 baseline structure: thesis, ordered sections, ending. Deliberately excludes any reader-state modeling (docs/14 §4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["outline_version", "task", "thesis", "sections", "ending"],
  "properties": {
    "outline_version": { "type": "integer", "const": 1 },
    "task": { "type": "string", "minLength": 1, "maxLength": 300 },
    "thesis": { "type": "string", "minLength": 5, "maxLength": 500 },
    "sections": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "title", "core_point", "support"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[1-8]$" },
          "role": { "enum": ["opening", "development", "turn", "closing"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 60 },
          "core_point": { "type": "string", "minLength": 5, "maxLength": 400 },
          "support": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 2, "maxLength": 300 }
          },
          "emphasis": { "enum": ["full", "brief", "omit"] },
          "transition_note": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "ending": { "type": "string", "minLength": 5, "maxLength": 400 },
    "style_notes": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "maxLength": 200 }
    }
  }
}
