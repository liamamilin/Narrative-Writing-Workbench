{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/run.schema.json",
  "title": "Narrative Writing Harness Run Metadata v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "timestamp",
    "models",
    "parameters",
    "usage",
    "patched",
    "status"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architect",
        "writer",
        "critic",
        "patcher"
      ],
      "properties": {
        "architect": {
          "type": "string"
        },
        "writer": {
          "type": "string"
        },
        "critic": {
          "type": "string"
        },
        "patcher": {
          "type": "string"
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "estimated_cost",
        "latency_seconds"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost": {
          "type": "number",
          "minimum": 0
        },
        "latency_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "patched": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "success",
        "failed"
      ]
    }
  }
}
